# .env.example
# -------------------------------------------------
# Root-level environment file template for NoticeMate.
# Copy this file to `.env` and fill in your API key:
#
#   cp .env.example .env
#
# -------------------------------------------------

# Gemini / OpenAI API key for Multimodal Vision & Document Intelligence
# Paste your Gemini API key (or OpenAI API key) below:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (SQLite)
DATABASE_URL=sqlite:///./notice_mate.db

# Environment & Server Config
ENVIRONMENT=development
PORT=8000